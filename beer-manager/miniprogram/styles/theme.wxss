@import "common.wxss";

/* 全局设计令牌：白底、轻边框、清晰数字，颜色仅表示状态。 */
page {
  --red: #ae2632;
  --red-soft: #fff3f3;
  --ink: #252827;
  --muted: #6f7782;
  --line: #e6e8e4;
  --surface: #ffffff;
  --surface-soft: #f1f3ef;
  --green: #267652;
  --orange: #aa6a16;
  --radius: 24rpx;
  background: #f5f6f3;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view, text, input, button { box-sizing: border-box; }
button::after { border: 0; }
button {
  width: auto;
  min-width: 0;
  margin: 0;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
}
button[disabled] { opacity: .42; }
