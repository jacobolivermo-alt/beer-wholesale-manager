.list { margin-top: 30rpx; }
.name { font-size: 34rpx; font-weight: 650; overflow-wrap: anywhere; }
.delete-btn { color: var(--red); background: #fff1f1; padding: 22rpx 20rpx; min-height: 104rpx; flex-shrink: 0; font-size: 26rpx; }
.list .row { align-items: center; }

.product-tabs,.product-buttons { display:flex;gap:16rpx; }
.product-tabs {margin-bottom:24rpx;}
.product-tabs button,.product-buttons button {flex:1;min-width:0;min-height:104rpx;white-space:normal;}
.product-tabs .selected {background:var(--red);color:white;}
.product-buttons {margin-top:22rpx;}
.product-restore {margin-top:22rpx;min-height:104rpx;color:var(--green);background:#edf6ef;}
