<view class="page">
  <view class="title">业务详情</view>
  <view class="subtitle">核对流水，保存对应收据</view>
  <view class="card form" wx:if="{{record}}">
    <view class="row"><text class="section-title">{{record.title}} ·
      {{record.customerName}}</text><text class="small muted">{{record.timeText}}</text></view>
    <view class="subtitle">{{record.description}}</view>
    <view class="hero-num" wx:if="{{record.type==='DELIVERY'||record.type==='PAYMENT'}}">¥{{record.amountText}}</view>
    <view class="hero-num" wx:else>{{record.quantityText}} {{record.unitText}}</view>
  </view>
  <view class="card form">
    <view class="row"><text class="section-title">相关收据</text><text class="small muted">{{receipts.length}} / 6 张</text>
    </view>
    <view class="footnote">支持拍照或相册图片，单张不超过 5MB。仅保存到当前设备。</view>
    <view class="receipt-grid">
      <view wx:for="{{receipts}}" wx:key="id">
        <image class="receipt-image" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}"
          bindtap="preview" /><button class="secondary" data-id="{{item.id}}" bindtap="remove"
          disabled="{{busy}}">移除</button>
      </view>
    </view>
    <empty-state wx:if="{{!receipts.length}}" text="尚未添加收据" hint="可保存送货签收单、付款截图或回瓶凭证" /><button class="primary"
      bindtap="upload" loading="{{busy}}" disabled="{{busy||receipts.length>=6}}">＋ 添加收据图片</button>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>

<confirm-dialog visible="{{dialogVisible}}" title="{{dialogTitle}}" rows="{{dialogRows}}" bind:accept="acceptDialog"
  bind:cancel="cancelDialog" />
