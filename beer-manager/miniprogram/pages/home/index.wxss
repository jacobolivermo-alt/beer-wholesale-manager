.stats { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; margin: 28rpx 0 22rpx; align-items: stretch; }
.delivery-shortcut { margin-top: 22rpx; }
.inventory, .attention { padding: 0 26rpx; }
.attention-row { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); align-items: baseline; font-size: 28rpx; }
.attention-name { flex: 1; min-width: 0; font-weight: 600; overflow-wrap: anywhere; }
.attention-value { max-width: 62%; text-align: right; font-size: 26rpx; overflow-wrap: anywhere; }
