.inventory, .records { padding: 0 26rpx; }
.balances { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; margin-top: 28rpx; }
.balances .card { min-width: 0; padding: 24rpx; }
.balances .number { font-size: 44rpx; line-height: 1.3; overflow-wrap: anywhere; }
.balances .label { font-size: 26rpx; }
.detail-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; }
.detail-actions button { width: 100%; min-height: 104rpx; padding: 22rpx 12rpx; font-size: 30rpx; }
.with-actions { padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); }
.stock-detail-row { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.stock-detail-row .row { flex-wrap: wrap; align-items: baseline; }
.stock-detail-row .small { margin-top: 10rpx; }
.stock-detail-row .number { font-size: 34rpx; }
.bottle-balance { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); flex-wrap: wrap; align-items: baseline; }
.bottle-balance .number { font-size: 34rpx; }
.form .section-title { margin-top: 0; }
.classify-controls { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }
.classify-controls .secondary { width: 100%; }
