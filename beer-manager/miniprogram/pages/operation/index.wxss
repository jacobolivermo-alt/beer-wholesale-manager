.form { margin-top: 28rpx; }
.delivery-row { padding: 24rpx; margin: 22rpx 0; background: #f8f9fb; border: 1rpx solid #e4e8ee; border-radius: 12rpx; }
.delivery-row.is-selected { background: #fff; border-color: #d7a2a7; }
.product-name { font-size: 32rpx; font-weight: 650; overflow-wrap: anywhere; }
.price { font-size: 26rpx; color: var(--red); margin: 10rpx 0; }
.payment-label { margin-top: 28rpx; }
.summary { margin: 12rpx 0 18rpx; flex-wrap: wrap; align-items: baseline; gap: 8rpx 16rpx; }
.summary .number { font-size: 40rpx; overflow-wrap: anywhere; }
.amount { font-size: 44rpx; height: 118rpx; font-weight: 650; }
.with-actions { padding-bottom: calc(440rpx + env(safe-area-inset-bottom)); }
.line-inputs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; margin-top: 22rpx; }
.line-inputs .label { font-size: 24rpx; min-height: 72rpx; margin-bottom: 8rpx; }
.compact { height: 104rpx; padding: 0 16rpx; font-size: 30rpx; }
.case-input { width: 100%; padding: 0 12rpx; text-align: center; }
.delivery-top { display: flex; flex-direction: column; gap: 24rpx; }
.quantity-field { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 28rpx; }
.case-converter { display: grid; grid-template-columns: 160rpx minmax(0, 1fr); align-items: center; gap: 16rpx; }
.case-converter .secondary { grid-column: 1 / -1; width: 100%; }
.inventory-toggle { display: flex; align-items: center; gap: 20rpx; }
.inventory-toggle .label { flex: 1; min-width: 0; margin-bottom: 0; line-height: 1.6; }
.inventory-toggle switch { flex-shrink: 0; }
.footer-error { color: var(--red); font-size: 26rpx; line-height: 1.5; margin-bottom: 16rpx; overflow-wrap: anywhere; }

.inventory-option { padding: 24rpx; background: #f1f3ef; border: 1rpx solid var(--line); border-radius: 12rpx; margin-top: 24rpx; }
