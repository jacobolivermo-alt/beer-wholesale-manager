@import "../../styles/common.wxss";
.product-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.product-name { flex: 1; min-width: 0; font-size: 30rpx; overflow-wrap: anywhere; }
.product-stock { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 12rpx; max-width: 62%; }
.stock { font-size: 38rpx; font-weight: 650; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
