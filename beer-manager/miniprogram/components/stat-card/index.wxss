@import "../../styles/common.wxss";
.stat { background: #fff; padding: 26rpx 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; min-height: 192rpx; height: 100%; }
.stat .label { font-size: 26rpx; margin-bottom: 22rpx; }
.stat-value { font-size: 52rpx; font-weight: 700; letter-spacing: -1.5rpx; line-height: 1.15; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.unit { font-size: 26rpx; color: var(--muted); margin-left: 8rpx; font-weight: 400; letter-spacing: 0; }
:host { min-width: 0; display: block; }
