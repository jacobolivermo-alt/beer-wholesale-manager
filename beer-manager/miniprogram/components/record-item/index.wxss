@import "../../styles/common.wxss";
.record { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.record-header { align-items: baseline; flex-wrap: wrap; gap: 8rpx 16rpx; }
.record-title { font-size: 28rpx; font-weight: 650; }
.record-time { font-size: 24rpx; color: var(--muted); }
.record-main { margin-top: 16rpx; align-items: baseline; flex-wrap: wrap; gap: 10rpx 16rpx; }
.customer { font-weight: 650; color: var(--ink); font-size: 32rpx; overflow-wrap: anywhere; }
.description { color: var(--muted); font-size: 26rpx; line-height: 1.65; margin-top: 12rpx; overflow-wrap: anywhere; white-space: pre-wrap; }
.record-value { font-size: 36rpx; font-weight: 700; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.record-unit { font-size: 26rpx; font-weight: 400; color: var(--muted); }
.receipt-note { font-size: 24rpx; color: var(--muted); margin-top: 14rpx; }
