<view wx:if="{{visible}}" class="dialog-mask" catchtouchmove="stop">
  <view class="dialog" catchtap="stop">
    <view class="dialog-header"><view class="dialog-eyebrow">操作确认</view><view class="dialog-title">{{title}}</view></view>
    <scroll-view scroll-y class="dialog-scroll" style="height:{{rows.length * 104}}rpx">
      <view class="dialog-row" wx:for="{{rows}}" wx:key="index"><text user-select="{{true}}">{{item}}</text></view>
    </scroll-view>
    <view class="dialog-actions"><button class="dialog-button secondary" bindtap="cancel">返回修改</button><button class="dialog-button primary" bindtap="accept">确认保存</button></view>
  </view>
</view>
